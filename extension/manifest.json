{
  "manifest_version": 3,
  "name": "업무 곁 세션 유지",
  "version": "1.2.0",
  "default_locale": "ko",
  "description": "열어 둔 업무포털·K-에듀파인·나이스 탭의 세션을 4분마다 연장합니다. 전국 17개 시도교육청에서 쓸 수 있으며, 처음 한 번 교육청을 고르고 사용을 허용하면 작동합니다.",
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sen.eduptl.kr/*",
    "https://klef.sen.go.kr/*"
  ],
  "optional_host_permissions": [
    "https://sen.neis.go.kr/*",
    "https://pen.eduptl.kr/*",
    "https://klef.pen.go.kr/*",
    "https://pen.neis.go.kr/*",
    "https://dge.eduptl.kr/*",
    "https://klef.dge.go.kr/*",
    "https://dge.neis.go.kr/*",
    "https://ice.eduptl.kr/*",
    "https://klef.ice.go.kr/*",
    "https://ice.neis.go.kr/*",
    "https://gen.eduptl.kr/*",
    "https://klef.gen.go.kr/*",
    "https://gen.neis.go.kr/*",
    "https://dje.eduptl.kr/*",
    "https://klef.dje.go.kr/*",
    "https://dje.neis.go.kr/*",
    "https://use.eduptl.kr/*",
    "https://klef.use.go.kr/*",
    "https://use.neis.go.kr/*",
    "https://sje.eduptl.kr/*",
    "https://klef.sje.go.kr/*",
    "https://sje.neis.go.kr/*",
    "https://goe.eduptl.kr/*",
    "https://klef.goe.go.kr/*",
    "https://goe.neis.go.kr/*",
    "https://gwe.eduptl.kr/*",
    "https://klef.gwe.go.kr/*",
    "https://gwe.neis.go.kr/*",
    "https://cbe.eduptl.kr/*",
    "https://klef.cbe.go.kr/*",
    "https://cbe.neis.go.kr/*",
    "https://cne.eduptl.kr/*",
    "https://klef.cne.go.kr/*",
    "https://cne.neis.go.kr/*",
    "https://jbe.eduptl.kr/*",
    "https://klef.jbe.go.kr/*",
    "https://jbe.neis.go.kr/*",
    "https://jne.eduptl.kr/*",
    "https://klef.jne.go.kr/*",
    "https://jne.neis.go.kr/*",
    "https://gbe.eduptl.kr/*",
    "https://klef.gbe.kr/*",
    "https://gbe.neis.go.kr/*",
    "https://gne.eduptl.kr/*",
    "https://klef.gne.go.kr/*",
    "https://gne.neis.go.kr/*",
    "https://jje.eduptl.kr/*",
    "https://klef.jje.go.kr/*",
    "https://jje.neis.go.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "업무 곁 세션 유지",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
